# PostgreSQL (index database - same as meidong-ai-assistant)
DATABASE_URL=postgresql://meidong_ai:ai@!reader@ai-postgres:5432/meidong_ai

# Nextcloud connection
NEXTCLOUD_BASE_URL=https://www.168mdsc.cn
NEXTCLOUD_WEBDAV_URL=http://nextcloud/remote.php/dav/files/ai_reader/
NEXTCLOUD_USER=ai_reader
NEXTCLOUD_APP_PASSWORD=ai@!reader

# Custom app API (for permission filtering)
NEXTCLOUD_PERMISSION_URL=http://nextcloud/index.php/apps/school_ai_permission/api/v1/files/check
NEXTCLOUD_PERSON_STORAGE_URL=http://nextcloud/index.php/apps/school_ai_permission/api/v1/storage/person
NEXTCLOUD_PERMISSION_TOKEN=

# Behavior
MAX_DOWNLOAD_MB=50
MAX_EXTRACT_FILE_MB=20