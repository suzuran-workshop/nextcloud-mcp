# ============================================================
# nextcloud-mcp 环境变量模板
# 复制为 .env 后填入真实值，切勿把 .env 提交到仓库
# ============================================================

# PostgreSQL（与 meidong-ai-assistant 共用同一个库；compose 网络内用容器名）
# 必填。密码含特殊字符时须做 URL 编码，例如 @ 写成 %40
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Nextcloud 服务账号（零鉴权：Agent 继承此账号的可见范围）
# 必填。对外访问地址，末尾不要带斜杠
NEXTCLOUD_BASE_URL=https://<NEXTCLOUD_HOST>
# 必填。容器内 WebDAV 地址，须以 / 结尾
NEXTCLOUD_WEBDAV_URL=http://<NEXTCLOUD_HOST>/remote.php/dav/files/<NEXTCLOUD_USER>/
# 必填。WebDAV 登录账号
NEXTCLOUD_USER=<NEXTCLOUD_USER>
# 必填。Nextcloud「应用密码」，不是登录密码
NEXTCLOUD_APP_PASSWORD=<NEXTCLOUD_APP_PASSWORD>

# 问数转发
# 复用 meidong-ai-assistant 的 /api/ask、/api/content/search、/api/semantic/search、/api/stats/*
AI_BASE_URL=http://<AI_HOST>:3100
# 内部调用令牌，留空则不带鉴权头
AI_INTERNAL_API_TOKEN=<AI_INTERNAL_API_TOKEN>
AI_USER_ID=<AI_USER_ID>

# 服务
PORT=3101
HOST=0.0.0.0

# 自建同步：启动后 5s 跑一次，之后每 AUTO_SYNC_INTERVAL_MINUTES 分钟一次
AUTO_SYNC_ON_START=true
AUTO_SYNC_INTERVAL_MINUTES=120
SYNC_TIMEOUT_MS=1200000
SYNC_MAX_DEPTH=20

# 限制
MAX_DOWNLOAD_MB=50
MAX_EXTRACT_FILE_MB=20
